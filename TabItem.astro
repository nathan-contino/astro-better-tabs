---
import { Marked } from "marked";

interface Props {
  label: string;
}

const { label } = Astro.props;

const id = `tab-${Math.random().toString(36).substring(2, 9)}`;

const remark = new Marked();
const markdownifiedLabel = remark.parseInline(label);
---

<input
  type="radio"
  name="%%TAB_GROUP%%"
  id={id}
  class="tab-input sr-only"
/>

<label
  for={id}
  class="tab-label px-4 py-1.5 my-1 ml-1 text-sm font-medium rounded-md cursor-pointer transition-all whitespace-nowrap text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
>
  <span set:html={markdownifiedLabel} />
</label>

<div class="tab-panel p-4 border-t">
  <slot />
</div>

<style is:global>
  @reference "tailwindcss";

  /* structural layout — explicit so these don't depend on Tailwind scanning node_modules */
  .tab-label  { order: 1; }
  .tab-spacer { order: 1; flex-grow: 1; }
  .tab-panel  { order: 2; width: 100%; display: none; }

  .tab-input:checked + .tab-label + .tab-panel { display: block; }

  /* panel colors — light mode */
  .tab-panel {
    @apply bg-white border-gray-200;
  }

  /* panel colors — dark mode */
  .dark .tab-panel {
    @apply bg-gray-900 border-gray-700;
  }

  /* active tab label — light mode */
  .tab-input:checked + .tab-label {
    @apply bg-white text-gray-900 font-bold shadow-sm;
  }

  /* active tab label — dark mode */
  .dark .tab-input:checked + .tab-label {
    @apply bg-gray-700 text-blue-400 font-bold shadow-sm;
  }
  .dark .tab-input:checked + .tab-label > span {
    @apply text-blue-200;
  }
</style>
